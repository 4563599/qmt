# Copy to .env.production locally. Do not commit the resulting file.
# Values are loaded literally: do not wrap them in quotes.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional: required only by the corresponding external/encrypted APIs.
TUSHARE_TOKEN=
KLINE_API_AES_KEY_B64=

# Optional public origin for workbook links (otherwise relative links are used).
# FOCUS_PAGE_URL=https://your-domain.example/%E9%87%8D%E7%82%B9%E5%85%B3%E6%B3%A8
# STOCK_WEB_EXPORT_DIR=/tmp/stock_web_exports
# DAILYSTOCK_DIR=/path/to/daily/reports
# GUNICORN_BIND=0.0.0.0:5000
